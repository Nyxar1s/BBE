# Copy this file to .env.local for local development,
# and add the same variables in your hosting provider (e.g. Vercel → Settings → Environment Variables).

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Site ---
# Public address of the site, used for links inside emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email notifications (resend.com → API Keys) ---
# Leave RESEND_API_KEY empty to turn emails off.
RESEND_API_KEY=
# Must use a domain you've verified in Resend, e.g. "BBE Events <bookings@bbeevents.com>".
EMAIL_FROM=BBE Events <onboarding@resend.dev>
# Where new-booking alerts go.
OWNER_EMAIL=hello@bbeevents.com

# --- Scheduling (optional) ---
# Your Cal.com or Calendly booking link, e.g. https://cal.com/bbe-events/consultation
# When set, clients can pick a meeting slot right after submitting the form.
NEXT_PUBLIC_SCHEDULING_URL=
